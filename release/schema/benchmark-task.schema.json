{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "benchmark-task.schema.json",
 "title": "sdl-workflows benchmark task",
 "description": "One file of modes/benchmark/tasks/: a task of a benchmark split and the recorded reference values that modes/benchmark/evaluate.py reproduces.",
 "type": "object",
 "additionalProperties": false,
 "required": ["task_id", "benchmark_id", "target", "item_rule", "inputs", "metric", "baseline_rule", "baseline_top1",
              "reference_model", "reference_model_top1", "diff_ci95_low", "diff_ci95_high", "n_test_items",
              "n_test_papers", "recorded_in"],
 "properties": {
  "task_id": {"type": "string"},
  "benchmark_id": {"type": "string"},
  "target": {"enum": ["module_type", "transfer_mode"]},
  "item_rule": {"type": "string"},
  "inputs": {"type": "string"},
  "metric": {"type": "string"},
  "baseline_rule": {"type": "string"},
  "baseline_top1": {"type": "number", "minimum": 0, "maximum": 1},
  "reference_model": {"type": "string"},
  "reference_model_top1": {"type": "number", "minimum": 0, "maximum": 1},
  "diff_ci95_low": {"type": "number", "minimum": -1, "maximum": 1},
  "diff_ci95_high": {"type": "number", "minimum": -1, "maximum": 1},
  "n_test_items": {"type": "integer", "minimum": 1},
  "n_test_papers": {"type": "integer", "minimum": 1},
  "recorded_in": {"type": "string"}
 }
}
